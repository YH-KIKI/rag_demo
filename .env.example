APP_NAME=rag-demo
DEBUG=false

# docker-compose.yml 의 postgres 컨테이너 환경변수와 값이 일치해야 함
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdemo
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdemo

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# 로컬에 다운로드한 데이터셋 경로 (또는 HuggingFace 허브 이름)
HF_DATASET_PATH=
HF_DATASET_SPLIT=train
HF_DATASET_TEXT_COLUMN=text

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
